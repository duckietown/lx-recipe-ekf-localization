<?xml version="1.0"?>
<package format="3">
  <name>encoder_pose</name>
  <version>2.0.0</version>
  <description>Dead-reckoning pose estimate of the Duckiebot from the wheel encoders (ROS 2).</description>
  <maintainer email="vincenzo.polizzi@student.ethz.ch">Vincenzo</maintainer>
  <license>GPLv3</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lx_ros2_tools</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
